# Infrastructure
POSTGRES_USER=pravah
POSTGRES_PASSWORD=pravah
POSTGRES_DB=pravah
NEO4J_AUTH=neo4j/pravah
NEO4J_PASSWORD=pravah
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Application
SECRET_KEY=dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Service URLs
database_url=postgresql+asyncpg://pravah:pravah@localhost:5432/pravah
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
OLLAMA_URL=http://localhost:11434

# Ollama models (single source of truth)
OLLAMA_CHAT_MODEL=minimax-m3:cloud
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_RERANK_MODEL=minimax-m3:cloud

# LLM / retrieval behavior
OLLAMA_EMBED_TIMEOUT=60
OLLAMA_CHAT_TIMEOUT=120
OLLAMA_RERANK_TIMEOUT=30
OLLAMA_RERANK_CONNECT_TIMEOUT=5
OLLAMA_RERANK_MAX_TOKENS=500
OLLAMA_CHAT_MAX_TOKENS=2000
OLLAMA_CHAT_TEMPERATURE=0.2
OLLAMA_RELATION_MAX_TOKENS=1000

# Test database override (defaults to local Postgres)
TEST_DATABASE_URL=postgresql+asyncpg://pravah:pravah@localhost:5432/pravah
