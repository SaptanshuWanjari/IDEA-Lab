# @name managerLogin
POST http://localhost:8000/auth/login
Content-Type: application/json

{
  "email": "manager@pravah.in",
  "password": "manager123"
}

### 12.2 Manager review MAP (expect 403 Forbidden)
POST http://localhost:8000/maps/{{generate.response.body.0.$.id}}/review
Content-Type: application/json

{
  "action": "approve"
}

### 12.3 Manager list regulations (allowed)
GET http://localhost:8000/regulations/

### 12.4 Re-login as compliance officer
# @name login
POST http://localhost:8000/auth/login
Content-Type: application/json

{
  "email": "admin@pravah.in",
  "password": "admin123"
}

# ============================================================
# 13. INFRASTRUCTURE VERIFICATION (manual, not API)
# ============================================================
# Qdrant collection (expect regulation_chunks with points):
#   GET http://localhost:6333/collections/regulation_chunks
#
# Neo4j graph (expect CONTAINS + relation edges):
#   docker compose exec neo4j cypher-shell -u neo4j -p pravah \
#     "MATCH (a:Clause)-[r:REQUIRES|AMENDS|DEFINES]->(b:Clause) RETURN a.id, type(r), b.id LIMIT 20"
#
# Ollama models:
#   curl http://localhost:11434/api/tags
